PORT=3001
NODE_ENV=development
HOST=0.0.0.0
FRONTEND_URL=https://whatappai.netlify.app
OWNER_NAME=Your Name
OWNER_SHORT_NAME=YourName

# Describe how YOU actually text (tone, common words/emoji, language mix).
# Fed into the AI's system prompt so replies sound like you. See
# backend/.env.example for a full example. Blank = neutral casual default.
PERSONA_DESCRIPTION=

# minimal (recommended) = AI handles almost everything with real context.
# full = old hardcoded template replies for greetings/identity/etc.
SIMPLE_BRAIN_MODE=minimal

# Persistent Baileys auth. Mount /data in production.
WHATSAPP_AUTH_PATH=./data/whatsapp-auth
MEMORY_PATH=./data/memory
UPLOADS_PATH=./data/uploads
FILES_PATH=./data/files
SCHEDULER_PATH=./data/scheduler
DATABASE_PATH=./data/database.sqlite

# ── Groq API Keys (PRIMARY — fast inference) ─────────────────────────────────
# Rotated automatically round-robin with rate-limit cooldown.
# Multiple ways to set keys (ALL are combined, duplicates removed):
#   a) Comma-separated list: GROQ_API_KEYS=key1,key2,key3
#   b) Single key:          GROQ_API_KEY=key1
#   c) Numbered keys:       GROQ_API_KEY1=key1  GROQ_API_KEY2=key2  ... (any count)
GROQ_API_KEYS=
GROQ_API_KEY=
GROQ_API_KEY1=
GROQ_API_KEY2=
GROQ_API_KEY3=
GROQ_API_KEY4=
GROQ_API_KEY5=
GROQ_API_KEY6=
GROQ_API_KEY7=
GROQ_API_KEY8=
GROQ_API_KEY9=
GROQ_API_KEY10=
GROQ_API_KEY11=
GROQ_API_KEY12=
GROQ_API_KEY13=

# ── Gemini API Keys (SECONDARY fallback + image vision) ──────────────────────
# Two key types supported — AUTO-DETECTED by llmService.js:
#   1) AQ.* keys       → use "x-goog-api-key" HTTP header    (paste from curl)
#   2) AIzaSy.* keys   → use ?key= QUERY parameter           (Google AI Studio)
#                        Get AI Studio keys: https://aistudio.google.com/apikey
#
# All formats below are combined + deduplicated — any number of keys supported.
#   a) Comma-separated list: GEMINI_API_KEYS=key1,key2,key3
#   b) Single key:          GEMINI_API_KEY=AQ....... or AIzaSy.......
#   c) Numbered keys:       GEMINI_API_KEY1=key1  GEMINI_API_KEY2=key2  ...
#
# Request body ALWAYS sends: system_instruction + role-tagged contents +
#                            generationConfig (required for AQ.* keys).
# Models tried (best first): gemini-flash-latest, gemini-2.0-flash-latest,
#   gemini-1.5-flash-latest, gemini-pro-latest, gemini-2.5-*-preview, and
#   the numbered/standard variants.
GEMINI_API_KEYS=
GEMINI_API_KEY=
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_API_KEY4=

LLM_PROVIDER_ORDER=groq,gemini
GROQ_TIMEOUT_MS=6000
GEMINI_TIMEOUT_MS=9000

ENABLE_GROUPS=false
ANALYZE_INCOMING_MEDIA=false
ENABLE_TTS=false
ENABLE_SELF_PING=false
LOG_LEVEL=info
ADMIN_TOKEN=
