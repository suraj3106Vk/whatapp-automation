# SK Agent — Environment Variables
# Copy this file to .env and fill in your values for local development.

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Owner ──────────────────────────────────────────────────────────────────────
OWNER_NAME=Your Full Name
OWNER_SHORT_NAME=YourName
OWNER_NUMBER=8554096571    # For owner control commands (stop/start/pause/status)

# Describe how YOU actually text — tone, common words/emoji, language mix,
# things you would/wouldn't say. This gets fed straight into the AI's system
# prompt so replies sound like you, not a generic assistant. A few sentences
# is enough. If left blank, a neutral "casual real person" default is used.
# Example:
# PERSONA_DESCRIPTION=Talks in casual Hinglish, mixes English and Hindi mid-sentence. Uses "bro"/"yaar" with friends, more respectful "ji"/"aap" with elders. Short replies, dry humor, never uses emojis except 😂 and 👍. Doesn't ask questions unless genuinely curious.
PERSONA_DESCRIPTION=

# Controls how much of the reply logic is hardcoded templates vs the AI:
#   minimal (default, recommended) — only true no-content messages (plain
#     "ok", filler, goodbyes, emoji reactions) are handled without the AI.
#     Everything else (greetings, "who are you", small talk, etc.) goes to
#     the AI with full conversation context, so replies are specific to what
#     was actually said instead of the same fixed line every time.
#   full — restores canned Marathi/Hindi template replies (bucketed by
#     guessed relationship) for greetings/identity/etc. before the AI ever
#     runs. Only use this if you specifically want fixed scripted replies.
SIMPLE_BRAIN_MODE=minimal

# ── Groq API Keys (primary LLM — fast) ────────────────────────────────────────
# Add any number of numbered keys (GROQ_API_KEY4, GROQ_API_KEY5, ...).
# GROQ_API_KEYS may also contain a comma-separated list.
GROQ_API_KEY=your_groq_key_here
GROQ_API_KEY1=your_groq_key2_here
GROQ_API_KEY2=your_groq_key3_here
GROQ_API_KEY3=your_groq_key4_here

# ── Gemini API Keys (fallback LLM + Vision for images) ────────────────────────
# Two key types supported — AUTO-DETECTED by llmService.js:
#   1) AQ.* keys       → use "x-goog-api-key" HTTP header    (your curl copy)
#   2) AIzaSy.* keys   → use ?key= QUERY parameter           (AI Studio)
# Get AI Studio keys: https://aistudio.google.com/apikey
# Add any number of numbered keys or use GEMINI_API_KEYS=k1,k2,k3
# Request always includes: system_instruction + role-tagged contents + generationConfig
# Models tried (best first): -latest aliases → -preview → numbered releases
GEMINI_API_KEY=your_gemini_key_here
GEMINI_API_KEY1=your_gemini_key2_here
GEMINI_API_KEY2=your_gemini_key3_here
GEMINI_API_KEY3=your_gemini_key4_here
GEMINI_API_KEY4=your_gemini_key5_here

# ── Ollama (local fallback — optional) ───────────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
